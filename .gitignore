# ==========================================
# PaperChat Root Git Ignore File
# ==========================================

# ------------------------------------------
# Environment & Secret Files
# ------------------------------------------
.env
.env.local
.env.*.local
.env.development
.env.production
*.pem
*.key

# ------------------------------------------
# Python & Virtual Environments (Backend)
# ------------------------------------------
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
*.so

# Python Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.hypothesis/

# Python Packaging
*.egg-info/
.eggs/
dist/
build/
sdist/

# Playwright & Debug Artifacts
backend/debug/
*.html.debug

# ------------------------------------------
# Node.js & Next.js (Frontend)
# ------------------------------------------
node_modules/
frontend/node_modules/

# Next.js Build Output
.next/
frontend/.next/
out/
frontend/out/

# Package Manager Logs & Caches
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.pnp
.pnp.*

# TypeScript & Build Caches
*.tsbuildinfo
frontend/next-env.d.ts

# Vercel Deployment
.vercel/

# ------------------------------------------
# Application Data & Generated Files
# ------------------------------------------
generated/
uploads/
scratch/

# ------------------------------------------
# OS & System Files
# ------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini

# ------------------------------------------
# IDE & Code Editor Files
# ------------------------------------------
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace
